+func TestKubernetesEmptyReservationCleanup(t *testing.T) {
+	api := &apiFixture{t: t}
+	k, target := adapter(t, api), adapterTarget()
+	r, err := k.Reserve(context.Background(), target)
+	if err != nil { t.Fatal("reservation prerequisite:", err) }
+	// Prove the fixture's no-op response before exercising production Remove.
+	_, status, err := k.call(context.Background(), http.MethodPut, target, false, *api.object)
+	if err != nil || status != http.StatusOK || metaString(*api.object, "resourceVersion") != r.ResourceVersion { t.Fatal("no-op version prerequisite failed") }
+	if err = k.Remove(context.Background(), target, r); err != nil || api.object != nil {
+		t.Errorf("empty reservation cleanup must reach DELETE: error=%v retained=%t", err, api.object != nil)
+	}
+}
+
+func TestKubernetesRemovalRetryAfterClearAndDeleteFailure(t *testing.T) {
+	api := &apiFixture{t: t, deleteFailures: 1}
+	k, target := adapter(t, api), adapterTarget()
+	r, err := k.Reserve(context.Background(), target)
+	if err != nil { t.Fatal("reservation prerequisite:", err) }
+	if err = k.Activate(context.Background(), target, r); err != nil { t.Fatal("activation prerequisite:", err) }
+	activeVersion := metaString(*api.object, "resourceVersion")
+	if err = k.Remove(context.Background(), target, r); err == nil { t.Fatal("delete failure prerequisite was not observed") }
+	if api.object == nil || len(api.object.Subjects) != 0 || api.deleteFailures != 0 || metaString(*api.object, "resourceVersion") == activeVersion { t.Fatal("clear-then-failed-delete prerequisite failed") }
+	clearedVersion := metaString(*api.object, "resourceVersion")
+	_, status, err := k.call(context.Background(), http.MethodPut, target, false, *api.object)
+	if err != nil || status != http.StatusOK || metaString(*api.object, "resourceVersion") != clearedVersion { t.Fatal("cleared no-op version prerequisite failed") }
+	if err = k.Remove(context.Background(), target, r); err != nil || api.object != nil {
+		t.Errorf("cleanup retry after cleared binding must reach DELETE: error=%v retained=%t", err, api.object != nil)
+	}
+}
