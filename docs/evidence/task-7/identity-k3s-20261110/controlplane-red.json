{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": "warden-system"}},
    {"apiVersion": "v1", "kind": "ServiceAccount", "metadata": {"name": "warden-controlplane", "namespace": "warden-system"}},
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "warden-controlplane", "namespace": "warden-system"},
      "spec": {
        "replicas": 1,
        "selector": {"matchLabels": {"app.kubernetes.io/name": "warden-controlplane"}},
        "template": {
          "metadata": {"labels": {"app.kubernetes.io/name": "warden-controlplane"}},
          "spec": {
            "serviceAccountName": "warden-controlplane",
            "containers": [{"name": "controlplane", "image": "warden/controlplane"}]
          }
        }
      }
    }
  ]
}
