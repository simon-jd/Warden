{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": "warden-system"}},
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {"name": "warden-controlplane", "namespace": "warden-system"},
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "warden-controlplane", "namespace": "warden-system"},
      "spec": {
        "replicas": 1,
        "selector": {"matchLabels": {"app.kubernetes.io/name": "warden-controlplane"}},
        "template": {
          "metadata": {"labels": {"app.kubernetes.io/name": "warden-controlplane"}},
          "spec": {
            "serviceAccountName": "warden-controlplane",
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "controlplane",
                "image": "warden/controlplane",
                "env": [{"name": "AZURE_FEDERATED_TOKEN_FILE", "value": "/var/run/secrets/azure/tokens/azure-identity-token"}],
                "volumeMounts": [
                  {"name": "kube-api-token", "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount", "readOnly": true},
                  {"name": "azure-identity-token", "mountPath": "/var/run/secrets/azure/tokens", "readOnly": true}
                ]
              }
            ],
            "volumes": [
              {
                "name": "kube-api-token",
                "projected": {
                  "sources": [
                    {"serviceAccountToken": {"expirationSeconds": 3600, "path": "token"}},
                    {"configMap": {"name": "kube-root-ca.crt", "items": [{"key": "ca.crt", "path": "ca.crt"}]}},
                    {"downwardAPI": {"items": [{"path": "namespace", "fieldRef": {"fieldPath": "metadata.namespace"}}]}}
                  ]
                }
              },
              {
                "name": "azure-identity-token",
                "projected": {
                  "sources": [
                    {"serviceAccountToken": {"audience": "api://AzureADTokenExchange", "expirationSeconds": 3600, "path": "azure-identity-token"}}
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
