# One k3s audit/v1 Event, or AKS exported record/properties.log (or records[]).
source = string!(.warden_source)
assert!(includes(["aks", "k3s"], source), "source_label")
message = string!(.message)
assert!(length(message) <= 16384, "record_size")
raw = object!(parse_json!(message))
records = [raw]
if source == "aks" && exists(raw.records) { records = array!(raw.records) }
assert!(length(records) > 0 && length(records) <= 128, "record_count")
events = []
for_each(records) -> |_index, record| {
  r = object!(record)
  if source == "aks" {
    assert!(includes(["kube-audit", "kube-audit-admin"], r.category), "aks_category")
    r = object!(parse_json!(string!(r.properties.log)))
  }
  assert!(r.apiVersion == "audit.k8s.io/v1" && r.kind == "Event", "audit_version")
  uid = string!(r.auditID)
  actor = string!(r.user.username)
  ips = array!(r.sourceIPs)
  assert!(length(ips) > 0 && length(ips) <= 32, "source_ips")
  ip = string!(ips[0])
  assert!(is_ipv4(ip) || is_ipv6(ip), "source_ip")
  operation = string!(r.verb)
  assert!(uid != "" && actor != "" && operation != "", "required_context")
  time = to_unix_timestamp(parse_timestamp!(string!(r.requestReceivedTimestamp), format: "%+"), unit: "milliseconds")
  activity = 99
  if operation == "create" { activity = 1 }
  if includes(["get", "list", "watch"], operation) { activity = 2 }
  if includes(["update", "patch"], operation) { activity = 3 }
  if includes(["delete", "deletecollection"], operation) { activity = 4 }
  status = 0
  if exists(r.responseStatus.code) {
    code = int!(r.responseStatus.code)
    assert!(code >= 100 && code <= 599, "http_status")
    if code >= 200 && code < 400 { status = 1 } else { status = 2 }
  }
  unmapped = {}
  for_each(r) -> |key, value| {
    if !includes(["apiVersion", "kind", "auditID", "verb", "requestReceivedTimestamp", "user", "sourceIPs", "responseStatus"], key) {
      unmapped = set!(unmapped, [key], value)
    }
  }
  assert!(length(encode_json(unmapped)) <= 2048, "unmapped_size")
  e = {"activity_id": activity, "category_uid": 6, "class_uid": 6003, "type_uid": 600300 + activity, "severity_id": 0, "time": time, "metadata": {"version": "1.3.0", "product": {"name": "Kubernetes Audit", "vendor_name": "Kubernetes"}, "uid": uid}, "api": {"operation": operation}, "actor": {"user": {"uid": actor}}, "src_endpoint": {"ip": ip}, "status_id": status, "unmapped": unmapped}
  if activity == 99 { e = set!(e, ["activity_name"], operation) }
  events = push(events, e)
}
. = events
